rules_version = '2';

// ============================================================================
// GXE Social Network - Cloud Firestore Security Rules
// ============================================================================
//
// Assumed Data Models:
//
// 1. users/{userId}
//    - id: string (optional) - user identifier
//    - name: string (required, 1..100 chars) - display name
//    - username: string (required, 1..50 chars) - unique handle
//    - avatar: string (required, <= 150000 chars) - profile avatar URL or data URL
//    - coverUrl: string (optional, <= 150000 chars) - profile cover URL or data URL
//    - email: string (optional, <= 150 chars) - email address
//    - bio: string (optional, <= 500 chars) - user bio
//    - location: string (optional, <= 200 chars) - location
//    - website: string (optional, <= 500 chars) - website URL
//    - banner: string (optional, <= 2000 chars) - banner image URL
//    - verified: bool (optional) - verification status
//    - isOnline: bool (optional) - online status
//    - createdAt: timestamp | number (optional) - creation time
//    - lastLogin: timestamp | number (optional) - last login time
//    - following: list of strings (optional, <= 5000 items) - followed user IDs
//    - followers: list of strings (optional, <= 5000 items) - follower user IDs
//    - followingCount: number (optional, >= 0)
//    - followersCount: number (optional, >= 0)
//
// 2. posts/{postId}
//    - author: map (required) with id, name, username, avatar
//    - content: string (required, 0..2000 chars) - post body text
//    - mediaUrl: string | null (optional, <= 2000 chars) - media attachment URL
//    - mediaType: string | null (optional, <= 20 chars) - image, video, file
//    - mediaName: string | null (optional, <= 255 chars) - attachment name
//    - mediaSize: string | null (optional, <= 50 chars) - attachment size string
//    - createdAt: number | timestamp (required) - creation timestamp
//    - likes: number (required, >= 0) - likes counter
//    - reposts: number (required, >= 0) - reposts counter
//    - commentsCount: number (required, >= 0) - comments counter
//    - likedBy: list of strings (required, <= 10000 items) - user IDs
//    - repostedBy: list of strings (required, <= 10000 items) - user IDs
//    - bookmarkedBy: list of strings (required, <= 10000 items) - user IDs
//    - pinned: bool (optional) - pinned post flag
//    - id: string (optional, <= 128 chars)
//
// 3. comments/{commentId}
//    - postId: string (required, 1..128 chars) - target post ID
//    - author: map (required) with id, name, username, avatar
//    - text: string (required, 1..1000 chars) - comment text
//    - createdAt: number | timestamp (required) - creation timestamp
//    - likes: number (optional, >= 0) - likes on comment
//    - id: string (optional, <= 128 chars)
//
// 4. notifications/{notificationId}
//    - recipientId: string (required, 1..128 chars) - recipient user ID
//    - sender: map (required) with id, name, username, avatar
//    - type: string (required, in ['like', 'comment', 'repost', 'follow', 'message'])
//    - postId: string | null (optional, <= 128 chars) - associated post ID
//    - postContent: string | null (optional, <= 500 chars) - snippet of post
//    - createdAt: number | timestamp (required) - timestamp
//    - read: bool (required) - read status
//    - id: string (optional, <= 128 chars)
//
// 5. chats/{chatId}/messages/{messageId}
//    - senderId: string (required, 1..128 chars) - sender user ID
//    - receiverId: string (required, 1..128 chars) - recipient user ID
//    - participants: list of strings (required, size == 2) - [uid1, uid2]
//    - text: string (required, 0..3000 chars) - direct message text
//    - mediaUrl: string | null (optional, <= 2000 chars) - optional image/media
//    - createdAt: number | timestamp (required) - timestamp
//    - read: bool (optional) - read status
//    - id: string (optional, <= 128 chars)
//
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Supports both Firebase Auth and Guest / Demo Mode
    function isUserOrGuest(userId) {
      return isAuthenticated() ? request.auth.uid == userId : (userId is string && userId.size() > 0);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidTimestampOrNumber(val) {
      return val is number || val is timestamp;
    }

    function isValidStringList(listVal, maxSize) {
      return listVal is list && listVal.size() <= maxSize;
    }

    function isValidAuthorMap(author) {
      return author is map &&
        author.keys().hasAll(['id', 'name', 'username', 'avatar']) &&
        author.id is string && author.id.size() > 0 && author.id.size() <= 128 &&
        author.name is string && author.name.size() > 0 && author.name.size() <= 100 &&
        author.username is string && author.username.size() > 0 && author.username.size() <= 50 &&
        author.avatar is string && author.avatar.size() <= 150000;
    }

    // ===============================================================
    // Domain Validators (Applied on BOTH create and update)
    // ===============================================================

    // --- User Validator ---
    function isValidUser(data) {
      let allowed = [
        'id', 'name', 'username', 'avatar', 'coverUrl', 'email', 'verified',
        'bio', 'location', 'website', 'banner', 'followersCount', 'followingCount',
        'following', 'followers', 'createdAt', 'lastLogin', 'isOnline'
      ];
      return data.keys().hasOnly(allowed) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.username is string && data.username.size() > 0 && data.username.size() <= 50 &&
        data.avatar is string && data.avatar.size() <= 150000 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('coverUrl' in data) || data.coverUrl == null || (data.coverUrl is string && data.coverUrl.size() <= 150000)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('website' in data) || (data.website is string && data.website.size() <= 500)) &&
        (!('banner' in data) || (data.banner is string && data.banner.size() <= 2000)) &&
        (!('verified' in data) || data.verified is bool) &&
        (!('isOnline' in data) || data.isOnline is bool) &&
        (!('followingCount' in data) || (data.followingCount is number && data.followingCount >= 0)) &&
        (!('followersCount' in data) || (data.followersCount is number && data.followersCount >= 0)) &&
        (!('following' in data) || isValidStringList(data.following, 5000)) &&
        (!('followers' in data) || isValidStringList(data.followers, 5000)) &&
        (!('createdAt' in data) || isValidTimestampOrNumber(data.createdAt)) &&
        (!('lastLogin' in data) || isValidTimestampOrNumber(data.lastLogin));
    }

    // --- Post Validator ---
    function isValidPost(data) {
      let allowed = [
        'id', 'author', 'content', 'mediaUrl', 'mediaType', 'mediaName', 'mediaSize',
        'createdAt', 'likes', 'reposts', 'commentsCount', 'likedBy', 'repostedBy',
        'bookmarkedBy', 'pinned'
      ];
      return data.keys().hasOnly(allowed) &&
        data.keys().hasAll(['author', 'content', 'createdAt', 'likes', 'reposts', 'commentsCount', 'likedBy', 'repostedBy', 'bookmarkedBy']) &&
        isValidAuthorMap(data.author) &&
        data.content is string && data.content.size() <= 2000 &&
        isValidTimestampOrNumber(data.createdAt) &&
        data.likes is number && data.likes >= 0 &&
        data.reposts is number && data.reposts >= 0 &&
        data.commentsCount is number && data.commentsCount >= 0 &&
        isValidStringList(data.likedBy, 10000) &&
        isValidStringList(data.repostedBy, 10000) &&
        isValidStringList(data.bookmarkedBy, 10000) &&
        (!('mediaUrl' in data) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 2000)) &&
        (!('mediaType' in data) || data.mediaType == null || (data.mediaType is string && data.mediaType.size() <= 20)) &&
        (!('mediaName' in data) || data.mediaName == null || (data.mediaName is string && data.mediaName.size() <= 255)) &&
        (!('mediaSize' in data) || data.mediaSize == null || (data.mediaSize is string && data.mediaSize.size() <= 50)) &&
        (!('pinned' in data) || data.pinned is bool) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    // Validates social engagement updates (likes, reposts, bookmarks, comments count)
    function isPostEngagementUpdate() {
      let allowedEngagementKeys = ['likes', 'likedBy', 'reposts', 'repostedBy', 'bookmarkedBy', 'commentsCount'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedEngagementKeys) &&
        areImmutableFieldsUnchanged(['author', 'content', 'createdAt', 'mediaUrl', 'mediaType', 'mediaName', 'mediaSize']) &&
        request.resource.data.likes is number && request.resource.data.likes >= 0 &&
        request.resource.data.reposts is number && request.resource.data.reposts >= 0 &&
        request.resource.data.commentsCount is number && request.resource.data.commentsCount >= 0 &&
        isValidStringList(request.resource.data.likedBy, 10000) &&
        isValidStringList(request.resource.data.repostedBy, 10000) &&
        isValidStringList(request.resource.data.bookmarkedBy, 10000);
    }

    // --- Comment Validator ---
    function isValidComment(data) {
      let allowed = ['id', 'postId', 'author', 'text', 'createdAt', 'likes'];
      return data.keys().hasOnly(allowed) &&
        data.keys().hasAll(['postId', 'author', 'text', 'createdAt']) &&
        data.postId is string && data.postId.size() > 0 && data.postId.size() <= 128 &&
        isValidAuthorMap(data.author) &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
        isValidTimestampOrNumber(data.createdAt) &&
        (!('likes' in data) || (data.likes is number && data.likes >= 0)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    // --- Notification Validator ---
    function isValidNotification(data) {
      let allowed = ['id', 'recipientId', 'sender', 'type', 'postId', 'postContent', 'createdAt', 'read'];
      return data.keys().hasOnly(allowed) &&
        data.keys().hasAll(['recipientId', 'sender', 'type', 'createdAt', 'read']) &&
        data.recipientId is string && data.recipientId.size() > 0 && data.recipientId.size() <= 128 &&
        isValidAuthorMap(data.sender) &&
        data.type in ['like', 'comment', 'repost', 'follow', 'message'] &&
        isValidTimestampOrNumber(data.createdAt) &&
        data.read is bool &&
        (!('postId' in data) || data.postId == null || (data.postId is string && data.postId.size() <= 128)) &&
        (!('postContent' in data) || data.postContent == null || (data.postContent is string && data.postContent.size() <= 500)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    // --- Direct Message Validator ---
    function isValidMessage(data) {
      let allowed = ['id', 'senderId', 'receiverId', 'participants', 'text', 'mediaUrl', 'createdAt', 'read'];
      return data.keys().hasOnly(allowed) &&
        data.keys().hasAll(['senderId', 'receiverId', 'participants', 'text', 'createdAt']) &&
        data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
        data.receiverId is string && data.receiverId.size() > 0 && data.receiverId.size() <= 128 &&
        data.participants is list && data.participants.size() == 2 &&
        data.text is string && data.text.size() <= 3000 &&
        isValidTimestampOrNumber(data.createdAt) &&
        (!('mediaUrl' in data) || data.mediaUrl == null || (data.mediaUrl is string && data.mediaUrl.size() <= 2000)) &&
        (!('read' in data) || data.read is bool) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;

      allow create: if isValidUser(request.resource.data) &&
                       isUserOrGuest(userId);

      allow update: if isValidUser(request.resource.data) && (
                       isUserOrGuest(userId) ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'followersCount'])
                     );

      allow delete: if isUserOrGuest(userId);
    }

    // 2. Posts Collection
    match /posts/{postId} {
      allow read: if true;

      allow create: if isValidPost(request.resource.data) &&
                       (isAuthenticated() ? request.auth.uid == request.resource.data.author.id : true);

      allow update: if (
                      (isValidPost(request.resource.data) &&
                       areImmutableFieldsUnchanged(['author', 'createdAt']) &&
                       (isAuthenticated() ? request.auth.uid == resource.data.author.id : true)) ||
                      isPostEngagementUpdate()
                    );

      allow delete: if isAuthenticated() ? request.auth.uid == resource.data.author.id : true;
    }

    // 3. Comments Collection
    match /comments/{commentId} {
      allow read: if true;

      allow create: if isValidComment(request.resource.data) &&
                       (isAuthenticated() ? request.auth.uid == request.resource.data.author.id : true);

      allow update: if isValidComment(request.resource.data) &&
                       areImmutableFieldsUnchanged(['postId', 'author', 'createdAt']) &&
                       (
                         (isAuthenticated() ? request.auth.uid == resource.data.author.id : true) ||
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                       );

      allow delete: if isAuthenticated() ? request.auth.uid == resource.data.author.id : true;
    }

    // 4. Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() ? request.auth.uid == resource.data.recipientId : true;

      allow create: if isValidNotification(request.resource.data) &&
                       (isAuthenticated() ? request.auth.uid == request.resource.data.sender.id : true);

      allow update: if isValidNotification(request.resource.data) &&
                       areImmutableFieldsUnchanged(['recipientId', 'sender', 'type', 'postId', 'postContent', 'createdAt']) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
                       (isAuthenticated() ? request.auth.uid == resource.data.recipientId : true);

      allow delete: if isAuthenticated() ? request.auth.uid == resource.data.recipientId : true;
    }

    // 5. Direct Chats & Messages Subcollection
    match /chats/{chatId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() ? (request.auth.uid in resource.data.participants) : true;

        allow create: if isValidMessage(request.resource.data) &&
                         (isAuthenticated() ? request.auth.uid == request.resource.data.senderId : true);

        allow update: if isValidMessage(request.resource.data) &&
                         areImmutableFieldsUnchanged(['senderId', 'receiverId', 'participants', 'text', 'mediaUrl', 'createdAt']) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
                         (isAuthenticated() ? request.auth.uid in resource.data.participants : true);

        allow delete: if isAuthenticated() ? request.auth.uid == resource.data.senderId : true;
      }
    }
  }
}
